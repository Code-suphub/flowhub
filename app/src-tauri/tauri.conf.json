{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlowHub Tauri",
  "version": "0.1.0",
  "identifier": "cn.ac.camellia.flowhub.tauri",
  "build": {
    "beforeDevCommand": "npm run dev:web -- --port 5174",
    "devUrl": "http://127.0.0.1:5174",
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "FlowHub Tauri",
        "url": "search.html",
        "width": 620,
        "height": 520,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "copyright": "Copyright © 2026 FlowHub contributors",
    "shortDescription": "A fast local launcher for apps and web bookmarks",
    "longDescription": "FlowHub Tauri migration prototype",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "infoPlist": "Info.plist",
      "signingIdentity": "-"
    }
  }
}
