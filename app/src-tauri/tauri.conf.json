{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlowHub",
  "version": "0.1.8",
  "identifier": "cn.ac.camellia.flowhub",
  "build": {
    "beforeDevCommand": "npm run dev:web -- --port 5174",
    "devUrl": "http://127.0.0.1:5174",
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "FlowHub",
        "url": "search.html",
        "width": 620,
        "height": 520,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "copyright": "Copyright © 2026 FlowHub contributors",
    "shortDescription": "A fast local launcher for apps and web bookmarks",
    "longDescription": "FlowHub is a fast local launcher for apps, web bookmarks, clipboard history and memos.",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist",
      "signingIdentity": "FlowHub Local Development"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU5QUM2NURBNENCNUNGQTMKUldTano3Vk0ybVdzNmFYcE02K29jOG5SRUN3S29WQXIzeTRTSlg2THBsKzA0b0RaTmtPNUJBbkMK",
      "endpoints": [
        "https://github.com/Code-suphub/flowhub/releases/latest/download/latest.json"
      ]
    }
  }
}
